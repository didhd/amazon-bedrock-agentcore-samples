# AWS Configuration
AWS_REGION=us-west-2
AWS_PROFILE=default

# Bedrock Configuration
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Tavily API (for web search and research)
TAVILY_API_KEY=your_tavily_api_key_here

# Memory Configuration (Mem0)
# Option 1: Use hosted Mem0 service
MEM0_API_KEY=your_mem0_api_key_here

# Option 2: Use local Mem0 with OpenAI embeddings
OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration
SQLITE_DATABASE_PATH=./data/customers.db

# Knowledge Base Configuration (Optional)
KNOWLEDGE_BASE_ID=your_knowledge_base_id

# Output Configuration
OUTPUT_DIR=./output

# AgentCore Configuration (for production deployment)
AGENTCORE_AGENT_NAME=agentcore_strands
AGENTCORE_REGION=us-west-2
AGENTCORE_ACCOUNT_ID=your_account_id

# Logging Configuration
LOG_LEVEL=INFO
ENABLE_DEBUG=false

# Memory Configuration
USER_ID=default_user
MEMORY_STORE_TYPE=local  # Options: local, hosted

# Tool Configuration
ENABLE_WEB_SEARCH=true
ENABLE_DATABASE_ANALYSIS=true
ENABLE_PYTHON_ANALYSIS=true
ENABLE_REPORT_GENERATION=true

# Retry Configuration
MAX_RETRIES=3
RETRY_DELAY=2

# Output Configuration
SAVE_REPORTS_TO_S3=false
S3_BUCKET_NAME=your_s3_bucket_name
S3_PREFIX=marketing-reports/